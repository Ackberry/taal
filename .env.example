# Firebase Web app configuration from Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The origin users visit. Set this to the HTTPS origin in production.
TAAL_APP_ORIGIN=http://localhost:3000

# Server only. Use Application Default Credentials locally or supply the
# service account JSON as a private deployment variable.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Private bucket name from Firebase Storage, without gs://.
FIREBASE_STORAGE_BUCKET=
